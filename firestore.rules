rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidActionLog(data) {
      return data.keys().hasAll(['id', 'userId', 'stepId', 'toolName', 'description', 'status', 'timestamp', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'stepId', 'toolName', 'description', 'details', 'status', 'timestamp', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.stepId is string && data.stepId.size() > 0 && data.stepId.size() <= 128 &&
             data.toolName is string && data.toolName.size() > 0 && data.toolName.size() <= 128 &&
             data.description is string && data.description.size() <= 2000 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 20000)) &&
             data.status in ['SUCCESS', 'FAILED', 'RUNNING', 'RETRYING'] &&
             isValidTimestamp(data.timestamp) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSecurityChat(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'lastMessage', 'timestamp', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'lastMessage', 'timestamp', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             data.lastMessage is string && data.lastMessage.size() <= 5000 &&
             isValidTimestamp(data.timestamp) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSecurityProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'description', 'category', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /users/{userId}/action_logs/{logId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidActionLog(request.resource.data);
      allow update: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidActionLog(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/security_chats/{chatId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidSecurityChat(request.resource.data);
      allow update: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidSecurityChat(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/security_projects/{projectId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidSecurityProject(request.resource.data);
      allow update: if isOwner(userId) &&
                       request.resource.data.userId == userId &&
                       isValidSecurityProject(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }
  }
}
